APP_NAME=Remote Dementia Monitoring API
APP_VERSION=0.1.0
AUTO_CREATE_TABLES=false

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dementia_monitoring

AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://dementia-monitoring-api
AUTH0_ALGORITHM=RS256
AUTH0_ROLES_CLAIM=https://dementia-monitoring-api/roles

ELEVENLABS_API_KEY=
GEMINI_API_KEY=
PRESAGE_API_KEY=
PRESAGE_API_URL=https://api.presage.example.com/v1/behavioral-risk
PRESAGE_TIMEOUT_SECONDS=10
